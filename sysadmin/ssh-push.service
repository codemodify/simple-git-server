[Unit]
Description=simple-git-server-ssh-push (SSH git receive-pack / upload-pack)
Documentation=https://github.com/codemodify/simple-git-server
# Access: this unit = SSH write (+ optional fetch) for authorized keys.
# Pair with simple-git-server.service on the same --git-repos-folder for public HTTPS read-only.
# Ops guide: sysadmin/readme-ssh-push.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/git
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Default bind is localhost — put a firewall / proxy in front for public SSH, or change --ssh-on.
ExecStart=/usr/bin/env simple-git-server-ssh-push --git-repos-folder /home/git --ssh-on "127.0.0.1:64222" --ssh-host-key /etc/ssh-push/host_key --ssh-authorized-keys /etc/ssh-push/authorized_keys --enable-ssh-write=true
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
