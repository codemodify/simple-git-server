[Unit]
Description=simple-git-server-ssh-read-write (SSH git receive-pack / upload-pack)
Documentation=https://github.com/codemodify/simple-git-server
# Access: this unit = SSH write (+ optional fetch) for authorized keys.
# Pair with simple-git-server.service on the same --git-repos-folder for public HTTPS read-only.
# Ops guide: ../readme.md ("push over ssh")
After=network.target

[Service]
Type=simple
# Run as the dedicated git account from ../readme.md, never root.
# The host key and authorized_keys under /etc/ssh-read-write must be readable by it.
User=git
Group=git
WorkingDirectory=/home/git
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Default bind is localhost — put a firewall / proxy in front for public SSH, or change --ssh-on.
# --enable-ssh-read = clone/fetch (upload-pack); --enable-ssh-write = push (receive-pack).
# Push is off by default, so this unit opts in explicitly.
ExecStart=/usr/bin/env simple-git-server-ssh-read-write --git-repos-folder /home/git --ssh-on "127.0.0.1:64222" --ssh-host-key /etc/ssh-read-write/host_key --ssh-authorized-keys /etc/ssh-read-write/authorized_keys --enable-ssh-read=true --enable-ssh-write=true
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
